# Production settings. Copy to /opt/signalnest/.env.prod on the host (chmod 600, owned by the
# deploy user). Never commit the real file. Generate secrets with: openssl rand -base64 32

DOMAIN=signalnest.example.com

POSTGRES_USER=signalnest
POSTGRES_PASSWORD=change-me-generate-a-long-random-value
POSTGRES_DB=signalnest

# Registration is closed by default. Create accounts with:
#   docker compose -f docker-compose.prod.yml run --rm -T api python -m app.cli create-user --email you@example.com --password-stdin
ALLOW_REGISTRATION=false

LOG_LEVEL=INFO
RUN_RETENTION_DAYS=14

# --- backups (used by ops/backup.sh on the host) ---
BACKUP_DIR=/var/backups/signalnest
BACKUP_KEEP_DAYS=14
# Optional hook run after each dump, with the file path as $1, e.g. upload to object storage:
#   BACKUP_UPLOAD_CMD=aws s3 cp --only-show-errors "$1" s3://my-bucket/signalnest/
BACKUP_UPLOAD_CMD=
