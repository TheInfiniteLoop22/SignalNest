# Placeholders only. Copy to .env (gitignored). Grows with each milestone — see docs/13_REPO_AND_DEVOPS.md §2.
ENV=dev
POSTGRES_USER=signalnest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=signalnest
DATABASE_URL=postgresql+asyncpg://signalnest:change-me@localhost:5432/signalnest
# --- SSRF (dev/test only; must be empty in prod) ---
ALLOWED_PORTS=80,443,8000-8999
SSRF_ALLOW_PRIVATE_CIDRS=
ALLOWED_HOSTS=

# --- auth / limits ---
ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=168
COOKIE_SECURE=false          # true behind HTTPS
EXPOSE_DOCS=true             # false in prod
MAX_MONITORS_PER_USER=50
MAX_MONITORS_PER_HOST=5
MIN_INTERVAL_S=30
