# Placeholders only. Copy to .env (gitignored). docker compose runs without it (defaults in the file).
ENV=dev
POSTGRES_USER=signalnest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=signalnest
DATABASE_URL=postgresql+asyncpg://signalnest:change-me@localhost:5432/signalnest

# --- worker ---
MAX_CONCURRENCY=20
POLL_INTERVAL_MS=1000
CLAIM_BATCH_MAX=50
SHUTDOWN_GRACE_S=20

# --- SSRF guard (dev only: lets probes reach Faultline on the docker network; empty otherwise) ---
ALLOWED_PORTS=80,443,8000-8999
SSRF_ALLOW_PRIVATE_CIDRS=
ALLOWED_HOSTS=

# --- accounts / limits ---
ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=168
COOKIE_SECURE=false          # true behind HTTPS
MAX_MONITORS_PER_USER=50
MIN_INTERVAL_S=30
