# {$DOMAIN} is the public hostname (DNS A/AAAA must point at this machine). Caddy obtains and
# renews the certificate automatically (ACME, HTTP-01 on port 80). For local testing set
# DOMAIN=localhost: Caddy then uses its own internal CA.

{$DOMAIN} {
	encode gzip

	# Operational endpoints are for the internal network only.
	@internal path /metrics /readyz /api/docs /api/openapi.json
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy api:8000 {
		# Do not buffer: responses are small, and this keeps request timing honest.
		flush_interval -1
	}
}
